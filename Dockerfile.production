FROM node:22-alpine AS builder

WORKDIR /home/app

COPY package*.json .npmrc ./
RUN npm ci

COPY . .

RUN npm run build && npm prune --omit=dev


FROM node:22-alpine AS runner

WORKDIR /home/app

# Apply current Alpine security patches
RUN apk upgrade --no-cache

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder --chown=appuser:appgroup /home/app/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /home/app/dist ./dist
COPY --from=builder --chown=appuser:appgroup /home/app/package.json ./

# npm/corepack are build tooling, not required by the running API
RUN rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack

USER appuser

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:5050/api/v1/health/live').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist/server.js"]